{
  "name": "@milosapps/somewhere-now",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node tools/verify-build-vendor.mjs",
    "build:pages": "tsc --noEmit && vite build --mode pages && node tools/verify-build-vendor.mjs --mode pages",
    "build:pages:release": "pnpm build:pages && node tools/stamp-pages-artifact.mjs && pnpm verify:pages:release",
    "verify:pages:release": "node tools/verify-pages-release.mjs",
    "test:shell": "node vendor/milosapps-shell/v2/verify.mjs --app-root . --manifest milos-app.json",
    "test:essentials": "node vendor/milosapps-essentials/v1/verify.mjs --app-root . --manifest milos-essentials.json",
    "preview": "vite preview --host 127.0.0.1",
    "preview:pages": "vite preview --host 127.0.0.1 --mode pages --base /MilosApps-Irgendwo/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:external": "node tools/run-external-e2e.mjs",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:all": "pnpm test:shell && pnpm test:essentials && pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "suncalc": "2.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
